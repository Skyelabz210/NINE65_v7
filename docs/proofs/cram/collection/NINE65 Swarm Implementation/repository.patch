+fn setup(n: usize) -> (CramMainClient, CramMainEvaluator) {
+    let mut config = SecureConfig::secure_256().into_config();
+    config.n = n;
+    config.t = 3;
+    config.security_bits = 0;
+    config.name = "encrypted GCD research arithmetic";
