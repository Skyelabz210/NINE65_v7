        let sq_low = CompositeBasis::sq_low();
        let r_prime_d2 = run_oracle(&prime, 2, 2, false, 2, 10000, 10000, 50000);
        let r_sq_d1 = run_oracle(&sq_low, 2, 1, false, 2, 10000, 10000, 50000);
        // Both should be in the 30-50% range (D_eff=2 under binary encoding)
        assert!(r_prime_d2.recall > 0.25 && r_sq_d1.recall > 0.25,
            "Both D_eff=2 configs should have decent recall: PRIME-D2={:.1}%, SQ-D1={:.1}%",
            r_prime_d2.recall * 100.0, r_sq_d1.recall * 100.0);
    }

    #[test]
    fn test_qcram_exponential_scaling() {
        // Verify that advantage grows exponentially with lane count
        let bases: Vec<CompositeBasis> = vec![
            CompositeBasis::new(&[3, 5], "2-lane"),
            CompositeBasis::new(&[3, 5, 7], "3-lane"),
            CompositeBasis::safe_prime(),
        ];
        let costs: Vec<f64> = bases.iter().map(|b| compute_qcram_cost(b).advantage).collect();
        // Each additional lane should roughly multiply the advantage
        assert!(costs[1] > costs[0] * 1.5, "3-lane should beat 2-lane");
        assert!(costs[2] > costs[1] * 3.0, "5-lane should beat 3-lane by > 3×");
    }

    #[test]
    fn test_oracle_coprimality_factors() {
        // The coprimality oracle factors exactly: ∏ valid_per_lane = actual coprime-pair count
        let basis = CompositeBasis::safe_prime();
        let valid_per_lane: Vec<u64> = basis.moduli.iter().map(|&m| {
            (0..m).filter(|&r| r != 0 && (r + 2) % m != 0).count() as u64
        }).collect();
        let product_valid: u64 = valid_per_lane.iter().product();
        let actual = (0..basis.product).filter(|&n| {
            gcd(n, basis.product) == 1 && gcd(n + 2, basis.product) == 1
        }).count() as u64;
        assert_eq!(product_valid, actual,
            "Oracle must factor: product={}, actual={}", product_valid, actual);
    }
