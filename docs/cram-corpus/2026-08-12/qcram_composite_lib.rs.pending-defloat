// Composite Basis Configuration
// ═══════════════════════════════════════════════════════════

/// A CRT basis configuration. Each modulus is p^k for some prime p.
#[derive(Clone, Debug)]
pub struct CompositeBasis {
    /// The moduli (e.g., [9, 25, 7, 11, 13])
    pub moduli: Vec<u64>,
    /// The base primes (e.g., [3, 5, 7, 11, 13])
    pub base_primes: Vec<u64>,
    /// The exponents (e.g., [2, 2, 1, 1, 1])
    pub exponents: Vec<u32>,
    /// Product of all moduli
    pub product: u64,
    /// Name for display
    pub name: String,
}

impl CompositeBasis {
    /// Create from explicit moduli. Each must be a prime power.
    pub fn new(moduli: &[u64], name: &str) -> Self {
        let mut base_primes = Vec::new();
        let mut exponents = Vec::new();
        for &m in moduli {
            let (p, k) = Self::prime_power_decompose(m);
            base_primes.push(p);
            exponents.push(k);
        }
        // Verify pairwise coprimality
        for i in 0..base_primes.len() {
            for j in (i+1)..base_primes.len() {
                assert_ne!(base_primes[i], base_primes[j],
                    "Base primes must be distinct: {} appears twice", base_primes[i]);
            }
        }
        let product: u64 = moduli.iter().product();
        CompositeBasis {
            moduli: moduli.to_vec(),
            base_primes,
            exponents,
            product,
            name: name.to_string(),
        }
    }

    /// Standard Safe Basis {3, 5, 7, 11, 13}
    pub fn safe_prime() -> Self { Self::new(&[3, 5, 7, 11, 13], "PRIME-5") }

    /// SQ-LOW {9, 25, 7, 11, 13}
    pub fn sq_low() -> Self { Self::new(&[9, 25, 7, 11, 13], "SQ-LOW") }

    /// SQ-SURFACE {3, 25, 7, 11, 13}
    pub fn sq_surface() -> Self { Self::new(&[3, 25, 7, 11, 13], "SQ-SURF") }

    /// SQ-BRIDGE {3, 5, 49, 11, 13}
    pub fn sq_bridge() -> Self { Self::new(&[3, 5, 49, 11, 13], "SQ-BRIDGE") }

    /// SQ-ALL {9, 25, 49, 121, 169}
    pub fn sq_all() -> Self { Self::new(&[9, 25, 49, 121, 169], "SQ-ALL") }

    /// CUBE-GND {27, 5, 7, 11, 13}
    pub fn cube_gnd() -> Self { Self::new(&[27, 5, 7, 11, 13], "CUBE-GND") }

    /// DEEP {27, 125, 49, 121, 169}
    pub fn deep() -> Self { Self::new(&[27, 125, 49, 121, 169], "DEEP") }

    /// Decompose n into (prime, exponent) where n = prime^exponent.
    fn prime_power_decompose(n: u64) -> (u64, u32) {
        assert!(n >= 2, "Modulus must be >= 2");
        let mut d = 2u64;
        while d * d <= n {
            if n % d == 0 {
                let mut k = 0u32;
                let mut m = n;
                while m % d == 0 { k += 1; m /= d; }
                assert_eq!(m, 1, "{} is not a prime power", n);
                return (d, k);
            }
            d += if d == 2 { 1 } else { 2 };
        }
        (n, 1) // n is prime
    }

    /// Maximum exponent in this basis
    pub fn k_max(&self) -> u32 { *self.exponents.iter().max().unwrap_or(&1) }

    /// Number of coprime integers in [0, product)
    pub fn coprime_count_below_product(&self) -> u64 {
        // Euler totient of product = ∏ p^(k-1) * (p-1)
        self.base_primes.iter().zip(&self.exponents)
            .map(|(&p, &k)| {
                let pk_minus_1 = if k > 1 { p.pow(k - 1) } else { 1 };
                pk_minus_1 * (p - 1)
            })
            .product()
    }
}

// ═══════════════════════════════════════════════════════════
// Nilpotent Analysis
// ═══════════════════════════════════════════════════════════

/// Nilpotent element in Z/p^k Z
#[derive(Clone, Debug)]
pub struct NilpotentElement {
    pub value: u64,
    pub p_adic_valuation: u32,
    pub annihilation_depth: u32,
    pub modulus: u64,
}

/// Analyze nilpotent structure of a prime power modulus.
pub fn nilpotent_census(p: u64, k: u32) -> Vec<NilpotentElement> {
    let pk = p.pow(k);
    let mut elements = Vec::new();
    for r in 1..pk {
        if r % p != 0 { continue; } // Only multiples of p are nilpotent
        // p-adic valuation
        let mut v = 0u32;
        let mut tmp = r;
        while tmp % p == 0 { v += 1; tmp /= p; }
        // Annihilation depth: ⌈log₂(k/v)⌉
        let depth = if v >= k { 0 } else {
            let ratio = (k as f64) / (v as f64);
            ratio.log2().ceil() as u32
        };
        // Verify by iterated squaring
        let mut x = r;
        let mut actual_depth = 0u32;
        for d in 1..=20 {
            x = (x as u128 * x as u128 % pk as u128) as u64;
            if x == 0 { actual_depth = d; break; }
        }
        assert_eq!(depth, actual_depth,
            "Depth formula mismatch: p={}, k={}, r={}, v={}, formula={}, actual={}",
            p, k, r, v, depth, actual_depth);
        elements.push(NilpotentElement { value: r, p_adic_valuation: v, annihilation_depth: depth, modulus: pk });
    }
    elements
}

/// Count nilpotent elements: p^(k-1) - 1
pub fn nilpotent_count(p: u64, k: u32) -> u64 {
    if k <= 1 { 0 } else { p.pow(k - 1) - 1 }
}

// ═══════════════════════════════════════════════════════════
// Sqr Carry and Residue Signatures
// ═══════════════════════════════════════════════════════════

/// Binary carry: C(r, m) = 1 if r > 0 and r² mod m < r
pub fn sqr_carry(r: u64, m: u64) -> u8 {
    if r > 0 && (r as u128 * r as u128 % m as u128) < r as u128 { 1 } else { 0 }
}

/// Sqr image size: |{r² mod m : r ∈ Z/mZ}|
pub fn sqr_image_size(m: u64) -> u64 {
    let mut seen = std::collections::HashSet::new();
    for r in 0..m {
        seen.insert((r as u128 * r as u128 % m as u128) as u64);
    }
    seen.len() as u64
}

/// Binary carry signature at given depth
pub fn binary_signature(n: u64, gap: u64, basis: &CompositeBasis, depth: u32) -> Vec<u8> {
    let mut sig = Vec::new();
    for &m in &basis.moduli {
        let mut r = (n + gap) % m;
        for _ in 0..depth {
            sig.push(sqr_carry(r, m));
            r = (r as u128 * r as u128 % m as u128) as u64;
        }
    }
    sig
}

/// Full residue signature at given depth
pub fn residue_signature(n: u64, gap: u64, basis: &CompositeBasis, depth: u32) -> Vec<u64> {
    let mut sig = Vec::new();
    for &m in &basis.moduli {
        let mut r = (n + gap) % m;
        for _ in 0..depth {
            r = (r as u128 * r as u128 % m as u128) as u64;
        }
        sig.push(r);
    }
    sig
}

