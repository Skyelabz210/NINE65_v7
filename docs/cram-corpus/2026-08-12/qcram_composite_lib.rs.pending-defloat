// K-Elimination Projector
// ═══════════════════════════════════════════════════════════

/// Test binary K-Elim projector idempotency rate
pub fn binary_projector_idempotency(p_measure: u64, p_anchor: u64) -> (u64, u64) {
    let space = 2 * p_anchor;
    let mut matches = 0u64;
    let inv2 = mod_inv(2, p_anchor as i64).unwrap();
    for c in 0..2u64 {
        for r_a in 0..p_anchor {
            let k = ((r_a as i64 - c as i64) * inv2).rem_euclid(p_anchor as i64) as u64;
            let v = c + 2 * k;
            let c_prime = sqr_carry(v % p_measure, p_measure);
            if c_prime as u64 == c { matches += 1; }
        }
    }
    (matches, space)
}

/// Test full-residue K-Elim projector idempotency rate
pub fn residue_projector_idempotency(p_measure: u64, p_anchor: u64) -> (u64, u64) {
    let space = p_measure * p_anchor;
    let mut matches = 0u64;
    let inv_p = mod_inv(p_measure as i64, p_anchor as i64).unwrap();
    for r in 0..p_measure {
        for r_a in 0..p_anchor {
            let k = ((r_a as i64 - (r % p_anchor) as i64) * inv_p).rem_euclid(p_anchor as i64) as u64;
            let v = r + p_measure * k;
            let r_prime = v % p_measure;
            if r_prime == r { matches += 1; }
        }
    }
    (matches, space)
}

