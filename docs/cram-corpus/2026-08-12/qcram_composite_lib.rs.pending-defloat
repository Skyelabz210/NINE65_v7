// Oracle (Sieve) Engine
// ═══════════════════════════════════════════════════════════

use std::collections::HashMap;

/// Result of an oracle run
#[derive(Clone, Debug)]
pub struct OracleResult {
    pub recall: f64,
    pub enrichment: f64,
    pub strata_count: usize,
    pub marked_count: usize,
    pub twin_count: u64,
    pub twin_found: u64,
}

/// Run the sieve oracle with binary or full-residue encoding.
pub fn run_oracle(
    basis: &CompositeBasis,
    gap: u64,
    depth: u32,
    use_residue: bool,  // true = full residue, false = binary carry
    cal_start: u64,
    cal_end: u64,
    hunt_start: u64,
    hunt_end: u64,
) -> OracleResult {
    // Calibrate
    let mut strata: HashMap<Vec<u64>, (u64, u64)> = HashMap::new();
    for n in cal_start..cal_end.saturating_sub(gap) {
        if gcd(n, basis.product) != 1 { continue; }
        let sig: Vec<u64> = if use_residue {
            residue_signature(n, gap, basis, depth).iter().map(|&r| r as u64).collect()
        } else {
            binary_signature(n, gap, basis, depth).iter().map(|&c| c as u64).collect()
        };
        let entry = strata.entry(sig).or_insert((0, 0));
        entry.0 += 1;
        if is_prime(n) && is_prime(n + gap) { entry.1 += 1; }
    }

    // Mark
    let avg: f64 = if strata.is_empty() { 0.0 } else {
        strata.values().map(|(t, p)| *p as f64 / *t as f64).sum::<f64>() / strata.len() as f64
    };
    let marked: std::collections::HashSet<Vec<u64>> = strata.iter()
        .filter(|(_, (t, p))| *t > 0 && (*p as f64 / *t as f64) > avg * 1.5)
        .map(|(k, _)| k.clone())
        .collect();

    // Hunt
    let mut tp = 0u64;
    let mut mp = 0u64;
    let mut mc = 0u64;
    let mut tc = 0u64;
    for n in hunt_start..hunt_end.saturating_sub(gap) {
        if gcd(n, basis.product) != 1 { continue; }
        tc += 1;
        let sig: Vec<u64> = if use_residue {
            residue_signature(n, gap, basis, depth).iter().map(|&r| r as u64).collect()
        } else {
            binary_signature(n, gap, basis, depth).iter().map(|&c| c as u64).collect()
        };
        let twin = is_prime(n) && is_prime(n + gap);
        if twin { tp += 1; }
        if marked.contains(&sig) {
            mc += 1;
            if twin { mp += 1; }
        }
    }

    let recall = if tp > 0 { mp as f64 / tp as f64 } else { 0.0 };
    let base_rate = if tc > 0 { tp as f64 / tc as f64 } else { 0.0 };
    let marked_rate = if mc > 0 { mp as f64 / mc as f64 } else { 0.0 };
    let enrichment = if base_rate > 0.0 { marked_rate / base_rate } else { 0.0 };

    OracleResult {
        recall,
        enrichment,
        strata_count: strata.len(),
        marked_count: marked.len(),
        twin_count: tp,
        twin_found: mp,
    }
}

// ═══════════════════════════════════════════════════════════
// Q-CRAM Cost Model
// ═══════════════════════════════════════════════════════════

/// Cost analysis for CRT-decomposed quantum search
#[derive(Clone, Debug)]
pub struct QCRAMCost {
    /// Standard Grover cost: π/4 √M
    pub standard_grover: f64,
    /// CRT-sequential: Σ π/4 √mᵢ
    pub crt_sequential: f64,
    /// CRT-parallel: π/4 √(max mᵢ)
    pub crt_parallel: f64,
    /// Advantage ratio (standard / parallel)
    pub advantage: f64,
}

pub fn compute_qcram_cost(basis: &CompositeBasis) -> QCRAMCost {
    let m_f = basis.product as f64;
    let pi_4 = std::f64::consts::PI / 4.0;
    let standard = pi_4 * m_f.sqrt();
    let sequential: f64 = basis.moduli.iter().map(|&m| pi_4 * (m as f64).sqrt()).sum();
    let max_m = *basis.moduli.iter().max().unwrap() as f64;
    let parallel = pi_4 * max_m.sqrt();
    QCRAMCost {
        standard_grover: standard,
        crt_sequential: sequential,
        crt_parallel: parallel,
        advantage: standard / parallel,
    }
}

