// ═══════════════════════════════════════════════════════════
// Core arithmetic
// ═══════════════════════════════════════════════════════════

pub fn gcd(a: u64, b: u64) -> u64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

pub fn mod_inv(a: i64, m: i64) -> Option<i64> {
    fn ext_gcd(a: i64, b: i64) -> (i64, i64, i64) {
        if b == 0 { (a, 1, 0) }
        else { let (g, x1, y1) = ext_gcd(b, a % b); (g, y1, x1 - (a / b) * y1) }
    }
    let (g, x, _) = ext_gcd(a.rem_euclid(m), m);
    if g != 1 { None } else { Some(x.rem_euclid(m)) }
}

pub fn mod_pow(mut base: u64, mut exp: u64, modulus: u64) -> u64 {
    if modulus == 1 { return 0; }
    let mut result = 1u64;
    base %= modulus;
    while exp > 0 {
        if exp & 1 == 1 { result = (result as u128 * base as u128 % modulus as u128) as u64; }
        exp >>= 1;
        base = (base as u128 * base as u128 % modulus as u128) as u64;
    }
    result
}

pub fn is_prime(n: u64) -> bool {
    if n < 2 { return false; }
    if n < 4 { return true; }
    if n % 2 == 0 || n % 3 == 0 { return false; }
    let mut d = 5u64;
    while d * d <= n {
        if n % d == 0 || n % (d + 2) == 0 { return false; }
        d += 6;
    }
    true
}

pub fn crt_reconstruct(residues: &[(u64, u64)]) -> Option<u64> {
    let big_m: u64 = residues.iter().map(|(_, m)| *m).product();
    let mut result: i64 = 0;
    for &(r_i, m_i) in residues {
        let big_m_i = big_m / m_i;
        let inv = mod_inv(big_m_i as i64, m_i as i64)?;
        result = (result + r_i as i64 * big_m_i as i64 * inv) % big_m as i64;
    }
    Some(result.rem_euclid(big_m as i64) as u64)
}

