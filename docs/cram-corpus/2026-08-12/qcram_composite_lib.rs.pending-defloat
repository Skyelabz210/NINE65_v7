    #[test]
    fn test_basis_construction() {
        let b = CompositeBasis::safe_prime();
        assert_eq!(b.product, 15015);
        assert_eq!(b.base_primes, vec![3, 5, 7, 11, 13]);
        assert_eq!(b.exponents, vec![1, 1, 1, 1, 1]);
