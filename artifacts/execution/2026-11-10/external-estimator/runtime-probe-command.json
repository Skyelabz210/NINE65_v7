[
  "docker",
  "--host=unix:///var/run/docker.sock",
  "run",
  "--rm",
  "--network=none",
  "--cap-drop=ALL",
  "--security-opt=no-new-privileges",
  "--memory=2g",
  "--cpus=1",
  "--pids-limit=256",
  "--user=1000:1000",
  "--read-only",
  "--tmpfs=/tmp:rw,nosuid,size=512m",
  "-e",
  "HOME=/tmp",
  "-e",
  "DOT_SAGE=/tmp/sage",
  "--workdir=/tmp",
  "sagemath/sagemath@sha256:19995db6194f4a4bab18ce9a88556fd15b9ed5e916b4504fefe618a7796ddbdb",
  "sage",
  "-python",
  "-c",
  "import sage.version, scipy, sys; print(sage.version.version); print(sys.version); print(scipy.__version__)"
]
